# Backend server
PORT=3000

# MySQL cloud database (PlanetScale/Railway MySQL/Aiven)
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# JWT
JWT_SECRET=change-this-super-secret-value
JWT_EXPIRES_IN=7d

# Allowed client origins (comma-separated). Use * only for temporary tests.
# Example: http://localhost:5173,https://monitoreo-buses.vercel.app
CLIENT_URL=http://localhost:5173
